---
// Card glyphs follow the hero's data → AI → workflows pieces (data drawn as
// a database here), so this section reads as those pieces, explained. Example icons are 24×24 line drawings.
const icons = {
  ai: '<path d="M12 3l2.2 6.3L20.5 11.5l-6.3 2.2L12 20l-2.2-6.3L3.5 11.5l6.3-2.2z" />',
  workflows: '<path d="M4 12h16M14 6l6 6-6 6" />',
  database: '<ellipse cx="12" cy="6" rx="7" ry="2.5" /><path d="M5 6v12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5V6M5 12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5" />',
  ingest: '<path d="M12 4v10M8 10l4 4 4-4M5 19h14" />',
  chart: '<path d="M4 20h16M7 16v-4M12 16V7M17 16v-6" />',
  bot: '<rect x="5" y="8" width="14" height="11" rx="2.5" /><path d="M12 4.5V8M9.5 13.5h.01M14.5 13.5h.01" />',
  search: '<circle cx="11" cy="11" r="6" /><path d="M19.5 19.5L15.5 15.5" />',
  plug: '<path d="M9 3.5V8M15 3.5V8M7 8h10v3a5 5 0 0 1-10 0V8zM12 16v4.5" />',
  funnel: '<path d="M4 5h16l-6 7.5V18l-4 2v-7.5L4 5z" />',
};

const capabilities = [
  {
    icon: icons.database,
    title: 'Data Engineering & Analytics',
    description: 'Design data pipelines, integrate sources, model reliable datasets, and make data usable for reporting and analysis.',
    examples: [
      { icon: icons.ingest, text: 'Source ingestion, transformations & orchestration' },
      { icon: icons.chart, text: 'Data models, dashboards & business analysis' },
    ],
  },
  {
    icon: icons.ai,
    title: 'Applied AI & Agentic Systems',
    description: 'Build AI-powered applications, agent workflows, retrieval systems, and backend integrations.',
    examples: [
      { icon: icons.bot, text: 'Agents that work with analytical data' },
      { icon: icons.search, text: 'Retrieval, conversation memory & application APIs' },
    ],
  },
  {
    icon: icons.workflows,
    title: 'Systems Integration & Automation',
    description: 'Connect APIs, business tools, and operational workflows to reduce repetitive work and improve reliability.',
    examples: [
      { icon: icons.plug, text: 'API integrations & workflow automation' },
      { icon: icons.funnel, text: 'Lead intake, validation & routing' },
    ],
  },
];
---

<section aria-labelledby="capabilities-heading" class="max-w-page mx-auto px-6 md:px-10 pt-16 md:pt-20">
  <h2 id="capabilities-heading" class="mono-label fade-up">What I work on</h2>
  <p class="mt-5 max-w-[50ch] text-[20px] md:text-[24px] leading-[1.5] tracking-tight text-ink fade-up">
    Mostly the messy middle: scattered data, AI prototypes,
    and tools that don't talk to each other.
  </p>
  <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
    {capabilities.map(({ icon, title, description, examples }, index) => (
      <div class="capability border-t border-border pt-6 fade-up" style={`--stagger: ${index}`}>
        <span class="capability-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" set:html={icon} />
        </span>
        <h3 class="mt-5 text-[17px] leading-snug text-ink">{title}</h3>
        <p class="mt-3 text-[14px] leading-[1.8] text-muted">{description}</p>
        <ul class="mt-5 space-y-2.5 text-[12.5px] leading-[1.6] text-muted" aria-label={`${title} examples`}>
          {examples.map(({ icon, text }) => (
            <li class="flex items-start gap-2.5">
              <svg class="example-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
              <span>{text}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  svg { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .capability-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgb(var(--ink) / .3);
    border-radius: 7px;
    color: rgb(var(--accent));
    transition: transform .3s ease, border-color .3s ease;
  }
  .capability-icon svg { width: 22px; height: 22px; }
  .capability:hover .capability-icon { transform: rotate(-4deg); border-color: rgb(var(--accent)); }
  .example-icon { flex-shrink: 0; width: 15px; height: 15px; margin-top: 2px; color: rgb(var(--accent)); }
  @media (prefers-reduced-motion: reduce) {
    .capability:hover .capability-icon { transform: none; }
  }
</style>
