---
import EmailButton from './EmailButton.astro';
import ConnectingPieces from './ConnectingPieces.astro';
import NomadPlane from './NomadPlane.astro';
import { CONTACT_EMAIL } from '@/data/site';
---
<section class="journal-hero" data-surface="hero">
  <div class="max-w-page mx-auto px-6 md:px-10">
    <div class="journal-meta"><span class="mono-label">Independent Data & AI Engineer</span><span class="mono-label">Filipino Digital Nomad / Salamanca <span role="img" aria-label="Spain">🇪🇸</span> / Remote worldwide</span></div>
    <div class="journal-intro">
      <div class="fade-up">
        <p class="journal-greeting">Hello, I’m Sandy.</p>
        <h1>Engineering<br />that turns<br />into <em>value.</em></h1>
        <ConnectingPieces />
        <p class="journal-description">From data pipelines to AI applications, I build the integrations and workflows that turn fragmented systems into something useful.</p>
        <div class="hero-actions"><a href="#work" class="btn-primary">Selected work <span aria-hidden="true">↗</span></a><EmailButton email={CONTACT_EMAIL} variant="link" label="Say hello →" surface="hero" /></div>
      </div>
      <figure class="journal-portrait fade-up" style="--stagger: 2">
        <div class="portrait-mat"><div class="portrait-crop"><img src="/img/sandy-bohol.jpg" alt="Sandy Lauguico smiling in an I love Bohol t-shirt" width="900" height="901" decoding="async" fetchpriority="high" /></div></div>
        <div class="portrait-plane"><NomadPlane /></div>
        <figcaption><span class="mono-label">Engineer by training. Always learning.</span><span class="aside">a little curiosity goes a long way.</span></figcaption>
      </figure>
    </div>
    <div class="journal-colophon"><p>8+ years across research & industry <span aria-hidden="true">·</span> IEEE-published</p><nav aria-label="Profiles"><a
            href="https://github.com/sclauguico"
            target="_blank"
            rel="noreferrer"
            aria-label="GitHub" title="GitHub"
            class="profile-icon"
          >
            <svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.93c.57.1.78-.25.78-.55v-2.02c-3.2.7-3.87-1.37-3.87-1.37-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.34.96.1-.74.4-1.25.72-1.54-2.55-.29-5.23-1.27-5.23-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.17a10.93 10.93 0 0 1 5.74 0c2.19-1.48 3.15-1.17 3.15-1.17.62 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.37-5.25 5.65.41.36.78 1.07.78 2.16v3.2c0 .31.2.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"/>
            </svg>
          </a><a
            href="https://www.linkedin.com/in/sandy-lauguico/"
            target="_blank"
            rel="noreferrer"
            aria-label="LinkedIn" title="LinkedIn"
            class="profile-icon"
          >
            <svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.67H9.35V9h3.42v1.56h.04c.48-.9 1.64-1.86 3.37-1.86 3.6 0 4.27 2.37 4.27 5.45v6.31zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zm1.78 13.02H3.56V9h3.56v11.45zM22.22 0H1.78C.8 0 0 .78 0 1.74v20.51C0 23.22.8 24 1.78 24h20.44c.98 0 1.78-.78 1.78-1.75V1.74C24 .78 23.2 0 22.22 0z"/>
            </svg>
          </a><a
            href="https://medium.com/@sclauguico"
            target="_blank"
            rel="noreferrer"
            aria-label="Medium" title="Medium"
            class="profile-icon"
          >
            <svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M13.54 12c0 3.04-2.42 5.5-5.4 5.5S2.73 15.04 2.73 12s2.42-5.5 5.4-5.5 5.41 2.46 5.41 5.5zm5.93 0c0 2.86-1.21 5.18-2.7 5.18-1.5 0-2.71-2.32-2.71-5.18s1.21-5.18 2.7-5.18c1.5 0 2.71 2.32 2.71 5.18zM22 12c0 2.56-.42 4.64-.95 4.64-.53 0-.96-2.08-.96-4.64s.43-4.64.96-4.64.95 2.08.95 4.64z"/>
            </svg>
          </a><a
            href="https://scholar.google.com.ph/citations?user=jiTezCwAAAAJ"
            target="_blank"
            rel="noreferrer"
            aria-label="Google Scholar" title="Google Scholar"
            class="profile-icon"
          >
            <svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M12 14l9-5-9-5-9 5 9 5z"/>
              <path d="M12 14l6.16-3.42A12 12 0 0 1 12 20a12 12 0 0 1-6.16-9.42L12 14z"/>
            </svg>
          </a></nav></div>
  </div>
</section>

<style>
  .journal-portrait { position: relative; }
  .portrait-plane { position: absolute; left: calc(100% + 24px); top: 85px; z-index: 1; }
  @media (max-width: 1439px) {
    .portrait-plane { position: static; display: flex; justify-content: flex-end; margin-top: 12px; }
  }
  /* A softer paper tone and firmer ink, confined to the light-mode hero. */
  :global(:root:not(.dark)) .journal-hero {
    background: #eeece2;
    color: #20362a;
  }
  :global(:root:not(.dark)) .journal-intro h1 {
    color: rgb(var(--rose));
  }
  :global(:root:not(.dark)) .portrait-mat {
    background: #e4e8d8;
    outline: 1px solid #c4ccb5;
    outline-offset: -1px;
    box-shadow: 0 3px 10px rgb(65 53 40 / .07);
  }
  :global(:root:not(.dark)) .journal-hero .journal-greeting,
  :global(:root:not(.dark)) .journal-hero .journal-description,
  :global(:root:not(.dark)) .journal-hero .journal-colophon {
    color: #465441;
  }
  :global(:root:not(.dark)) .journal-hero .journal-meta .mono-label,
  :global(:root:not(.dark)) .journal-hero figcaption .mono-label {
    color: #50604b;
  }
</style>
