---

<section aria-labelledby="recommendations-heading" class="max-w-page mx-auto px-6 md:px-10 pt-20 md:pt-24">
  <div class="hairline fade-up" aria-hidden="true"></div>
  <div class="mt-6 fade-up">
    <h2 id="recommendations-heading" class="text-[24px] md:text-[30px] leading-snug tracking-tight text-ink">People I’ve worked with</h2>
    <p class="mt-3 text-[13px] leading-relaxed text-muted">A few words from LinkedIn recommendations, shared here as excerpts.</p>
  </div>
  <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
    {recommendations.map(({ name, context, date, datetime, quote }, index) => (
      <figure class="border-t border-border pt-6 fade-up" style={`--stagger: ${index % 2}`}>
        <blockquote class="text-[16px] leading-[1.85] text-ink">
          <p>“{quote}”</p>
        </blockquote>
        <figcaption class="mt-5 text-[12px] leading-[1.8] text-muted">
          <span class="block text-[14px] font-medium text-ink">{name}</span>
          <span class="block">{context}</span>
          <time datetime={datetime}>{date}</time>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
