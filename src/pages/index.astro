---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Capabilities from '@/components/Capabilities.astro';
import StackSection from '@/components/StackSection.astro';
import ProjectsSection from '@/components/ProjectsSection.astro';
import About from '@/components/About.astro';
import Recommendations from '@/components/Recommendations.astro';
import Contact from '@/components/Contact.astro';
import GitHubActivity from '@/components/GitHubActivity.astro';
import FeaturedWork from '@/components/FeaturedWork.astro';
---

<Base>
  <Hero />
  <Capabilities />
  <FeaturedWork />
  <About />
  <Recommendations />
  <GitHubActivity />

  <ProjectsSection
    id="de"
    index="02"
    label="Data Engineering"
    title="Pipelines, warehouses, and the boring bits done right."
    kicker="Selected projects."
    discipline="DE"
    space="tight"
  >
  </ProjectsSection>

  <ProjectsSection
    id="ds"
    index="02.5"
    label="Data Science & Analytics"
    title="Modeling, measuring, making sense of it."
    kicker="Selected projects."
    discipline="DS"
    space="loose"
  >
  </ProjectsSection>

  <ProjectsSection
    id="ml"
    index="03"
    label="Machine Learning"
    title="Vision, models, and research that shipped."
    kicker="Selected projects."
    discipline="ML"
    space="normal"
  >
  </ProjectsSection>

  <ProjectsSection
    id="ai"
    index="04"
    label="AI Engineering"
    title="Agents, and the systems around them."
    kicker="Selected projects."
    discipline="AI"
    space="tight"
  >
  </ProjectsSection>

  <StackSection />
  <Contact />
</Base>
