const recommendations = [
  {
    name: 'Stephen Mackley',
    context: 'Worked together on the Mentor Collective account',
    date: 'October 24, 2022',
    datetime: '2022-10-24',
    quote: "I came to rely upon Sandy's analyses for our operational decisions and program assessments. Sandy was always timely in her work, but also not afraid to ask if the requested methodology or assessment question would produce the insights I was looking for.",
  },
  {
    name: 'Athena Rosz Ann Pascua',
    context: 'Reported directly to Sandy at Boldr',
    date: 'November 24, 2022',
    datetime: '2022-11-24',
    quote: 'You can always count on her to work with you side by side and walk you through the hard parts, and trusts our knowledge and expertise as well. She is the kind of person you would love to listen to.',
  },
  {
    name: 'Zaahid Johaar',
    context: 'Managed Sandy directly at Boldr',
    date: 'October 26, 2022',
    datetime: '2022-10-26',
    quote: 'She has good experience working closely with business stakeholders to realize their goals and create various solutions.',
  },
  {
    name: 'Rameez Fredericks',
    context: 'Managed Sandy directly',
    date: 'October 26, 2022',
    datetime: '2022-10-26',
