---
import type { Project } from '@/data/projects';
interface Props {
  project: Project;
  number: number;
}
const { project, number } = Astro.props;
const disciplineLabel: Record<Project['discipline'], string> = {
  DE: 'Data Eng',
  DS: 'Data Science',
  ML: 'Machine Learning',
  AI: 'AI Eng',
};
const aspect = project.aspect ?? 'aspect-[16/10]';

// Work without a public artefact still belongs on the page — it just isn't
// a link, and shouldn't pretend to be one.
const Tag = project.href ? 'a' : 'div';
const linkProps = project.href
  ? { href: project.href, target: '_blank', rel: 'noreferrer' }
  : {};
---

{/* A file label and technology tags make each project easy to scan. */}
<Tag {...linkProps} class="group block fade-up project-plate">
  <div class="project-filebar"><span class="mono-label">{disciplineLabel[project.discipline]} / {String(number).padStart(2, '0')}</span><span class="project-open">{project.href ? 'Explore ↗' : 'Research / project'}</span></div>
  <div class={`relative overflow-hidden bg-ink/[0.04] ${aspect}`}>
    <img
      src={project.image}
      alt={project.title}
      width="1200"
      height="750"
      loading="lazy"
      decoding="async"
      class="plate-img absolute inset-0 h-full w-full object-cover"
    />
  </div>

  <div class="project-caption">
      <h3
        class:list={[
          'heading text-[17px] md:text-[18px] text-ink transition-opacity duration-300',
          project.href && 'group-hover:opacity-60',
        ]}
      >
        {project.title}
      </h3>

      <ul class="project-tags" aria-label="Technologies">
        {project.stack.map(tool => <li>{tool}</li>)}
      </ul>
  </div>
</Tag>
