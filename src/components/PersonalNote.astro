---
import type { CollectionEntry } from 'astro:content';
import { topics } from '@/data/personal';
interface Props { note: CollectionEntry<'notes'>; }
const { note } = Astro.props;
const href = `/field-notes/notes/${note.id}/`;
---
<article class:list={['personal-note', `personal-note--${note.data.type}`, { 'personal-note--photo': Boolean(note.data.image) }]} data-personal-reveal>
  {note.data.image && (
    <a href={href} class="personal-note-photo" tabindex="-1" aria-hidden="true">
      <img src={note.data.image.src} alt="" width={note.data.image.width} height={note.data.image.height} loading="lazy" decoding="async" />
    </a>
  )}
  <div class="personal-note-copy">
    <p class="personal-eyebrow">{note.data.tags.map(tag => topics[tag]).join(' / ')}</p>
    <h3>{note.data.standalone ? <a href={href}>{note.data.title}</a> : note.data.title}</h3>
    <p class="personal-note-summary">{note.data.summary}</p>
    <div class="personal-note-bottom">
      <span>{note.data.type === 'note' ? 'A short note' : 'A little story'}</span>
      {note.data.date && <time datetime={note.data.date.toISOString().slice(0, 10)}>{note.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}</time>}
      {note.data.standalone && <a href={href} aria-label={`Read ${note.data.title}`}>Read <span aria-hidden="true">↗</span></a>}
    </div>
  </div>
</article>
